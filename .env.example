# ---------------------------------------------------------------------------
# JARVIS Core Configuration File (.env)
# Copy this file to .env and modify settings as needed.
# ---------------------------------------------------------------------------

# System & Application
JARVIS_ENV=production
JARVIS_DEBUG=false
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# LLM Models (Ollama)
JARVIS_CHAT_MODEL=qwen3.5:4b
JARVIS_VISION_MODEL=qwen2.5vl:3b
JARVIS_OLLAMA_HOST=http://localhost:11434

# Speech Recognition & Synthesis (STT / TTS)
JARVIS_STT_WAKE_MODEL=tiny
JARVIS_STT_CMD_MODEL=base
JARVIS_WAKE_PHRASES=i'm back,hey jarvis,jarvis,ok jarvis
JARVIS_PIPER_EXE=
JARVIS_VOICE_MODEL=

# Security & Execution
JARVIS_MAX_TERMINAL_COMMAND_LEN=512
JARVIS_EXECUTION_TIMEOUT=30

# Memory & Storage
JARVIS_MEMORY_FILE=memory.json
JARVIS_REMINDERS_FILE=reminders.json
